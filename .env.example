# Runtime profile
APP_ENV=local

# Data paths
BEAR_RAW_DIR=data/bear_raw
BEAR_PROCESSED_DIR=data/bear_processed
DOCUMENTS_DIR=data/documents
EVAL_DATASET=data/eval/hvac_eval.jsonl

# Model and retrieval placeholders for later phases.
LLM_PROVIDER=
LLM_MODEL=
EMBEDDING_MODEL=
VECTOR_STORE_BACKEND=

# Optional DeepSeek answer generation. Leave DEEPSEEK_API_KEY empty to use the
# deterministic evidence-grounded fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
