# Runtime profile
APP_ENV=local

# Data paths
BEAR_RAW_DIR=data/bear_raw
BEAR_PROCESSED_DIR=data/bear_processed
DOCUMENTS_DIR=data/documents
EVAL_DATASET=data/eval/hvac_eval.jsonl

# Model and retrieval placeholders for later phases.
# LLM_PROVIDER can be empty, deterministic, deepseek, or ollama.
LLM_PROVIDER=
LLM_MODEL=
EMBEDDING_MODEL=
VECTOR_STORE_BACKEND=

# Optional DeepSeek answer generation. Leave DEEPSEEK_API_KEY empty to use the
# deterministic evidence-grounded fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30

# Optional local Ollama answer generation. Set LLM_PROVIDER=ollama to use it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60

# Optional LangGraph LLM route planner. The interactive /ask path defaults to
# auto: DeepSeek when DEEPSEEK_API_KEY is set, otherwise deterministic. Invalid
# LLM plans or API failures fall back to the deterministic planner and are
# recorded in workflow_trace.
LANGGRAPH_PLANNER_PROVIDER=auto
LANGGRAPH_PLANNER_MODEL=deepseek-chat
LANGGRAPH_PLANNER_TIMEOUT_SECONDS=20
